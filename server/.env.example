# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Spotify Developer Credentials
# Create an application at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:5000/callback

# Security & Session
# Cookie Secret (optional for cookie signature)
COOKIE_SECRET=your_random_secret_cookie_key_32_chars

# Render / Cloud Keep-Alive (automatically populated on Render as RENDER_EXTERNAL_URL)
# Or define BACKEND_URL manually to keep free instances awake 24/7
BACKEND_URL=https://your-service-name.onrender.com

