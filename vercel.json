{
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://spotigalaxy-backend.onrender.com/api/:path*"
    },
    {
      "source": "/login",
      "destination": "https://spotigalaxy-backend.onrender.com/login"
    },
    {
      "source": "/callback",
      "destination": "https://spotigalaxy-backend.onrender.com/callback"
    },
    {
      "source": "/refresh_token",
      "destination": "https://spotigalaxy-backend.onrender.com/refresh_token"
    },
    {
      "source": "/logout",
      "destination": "https://spotigalaxy-backend.onrender.com/logout"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
